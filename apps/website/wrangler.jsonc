{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bewise-website",
  "account_id": "9ee3d7479a3c359681e3fab2c8cb22c0",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Routes (not custom domains): the zone keeps its proxied DNS records and the
  // Worker answers every request before it reaches the old origin.
  "routes": [
    { "pattern": "bewise.love/*", "zone_name": "bewise.love" },
    { "pattern": "www.bewise.love/*", "zone_name": "bewise.love" }
  ]
}
