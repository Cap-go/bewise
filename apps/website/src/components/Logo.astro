---
interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
---

<a href="/" class:list={['group inline-flex items-center gap-2.5 rounded-xl', className]} aria-label="BeWise home">
  <img
    src="/icon-128.png"
    alt=""
    width="36"
    height="36"
    class="size-9 rounded-[0.7rem] ring-1 ring-white/15 shadow-[0_6px_20px_-6px_rgb(0_192_255/0.6)] transition-transform duration-300 group-hover:-rotate-6"
  />
  <span class="font-display text-[1.35rem] font-semibold tracking-tight">BeWise</span>
</a>
