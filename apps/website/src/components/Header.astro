---
import { nav, site } from '../data/site'
import Logo from './Logo.astro'
---

<header class="sticky top-0 z-50 border-b border-white/[0.06] bg-ink/70 backdrop-blur-xl backdrop-saturate-150">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 sm:px-8">
    <Logo />
    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-1 text-[0.92rem] font-medium text-white/70">
        {
          nav.map(item => (
            <li>
              <a href={item.href} class="rounded-full px-3.5 py-2 transition-colors hover:bg-white/[0.06] hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a
        href={site.github}
        class="hidden size-10 place-items-center rounded-full text-white/70 transition-colors hover:bg-white/[0.06] hover:text-white sm:grid"
        aria-label="BeWise on GitHub"
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
      </a>
      <a
        href={site.appStore}
        class="inline-flex h-10 items-center gap-2 rounded-full bg-white px-4 text-sm font-semibold text-ink shadow-[0_8px_24px_-10px_rgb(166_255_203/0.6)] transition hover:bg-mint"
      >
        Get the app
      </a>
      <details class="group relative md:hidden">
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center rounded-full text-white/80 hover:bg-white/[0.06] [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg viewBox="0 0 24 24" class="size-5 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg viewBox="0 0 24 24" class="hidden size-5 group-open:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </summary>
        <nav aria-label="Mobile" class="absolute top-12 right-0 w-56 overflow-hidden rounded-2xl border border-white/10 bg-ink-2/95 p-2 shadow-2xl backdrop-blur-xl">
          <ul class="text-[0.95rem] font-medium">
            {
              nav.map(item => (
                <li>
                  <a href={item.href} class="block rounded-xl px-4 py-3 text-white/80 hover:bg-white/[0.06] hover:text-white">
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={site.github} class="block rounded-xl px-4 py-3 text-white/80 hover:bg-white/[0.06] hover:text-white">GitHub</a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
