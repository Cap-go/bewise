{
  "name": "@bewise/mobile",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc -b",
    "sync": "bun run build && cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#00c0ff' --splashBackgroundColor '#0b1016' --splashBackgroundColorDark '#0b1016'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-in-app-review": "^8.2.4",
    "@capgo/capacitor-native-navigation": "^8.4.2",
    "@capgo/capacitor-transitions": "^8.2.4",
    "@capgo/capacitor-updater": "^8.52.1",
    "@fontsource-variable/fraunces": "latest",
    "@fontsource-variable/inter": "latest",
    "vue": "^3.5.43",
    "vue-i18n": "^11.2.1",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@capacitor/assets": "latest",
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "latest",
    "@vue/tsconfig": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vue-tsc": "latest"
  }
}
