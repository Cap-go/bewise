---
import { site } from '../data/site'

interface Props {
  class?: string
  center?: boolean
}
const { class: className = '', center = false } = Astro.props
---

<div class:list={['flex flex-wrap items-center gap-3', center && 'justify-center', className]}>
  <a
    href={site.appStore}
    class="group inline-flex h-14 items-center gap-3 rounded-2xl bg-white pr-6 pl-4 text-ink shadow-[0_14px_40px_-14px_rgb(0_217_242/0.7)] transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_18px_50px_-14px_rgb(0_217_242/0.9)]"
    aria-label="Download BeWise on the App Store"
  >
    <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true">
      <path d="M16.37 12.73c-.02-2.3 1.88-3.4 1.97-3.46-1.07-1.57-2.74-1.78-3.33-1.8-1.42-.15-2.77.83-3.49.83-.72 0-1.83-.81-3.01-.79-1.55.02-2.98.9-3.78 2.29-1.61 2.8-.41 6.94 1.16 9.21.77 1.11 1.68 2.36 2.88 2.31 1.16-.05 1.6-.75 3-.75s1.79.75 3.01.72c1.25-.02 2.03-1.13 2.79-2.25.88-1.29 1.24-2.54 1.26-2.6-.03-.01-2.42-.93-2.46-3.71ZM14.08 5.98c.64-.78 1.07-1.85.95-2.92-.92.04-2.03.61-2.69 1.38-.59.68-1.11 1.78-.97 2.83 1.02.08 2.07-.52 2.71-1.29Z" />
    </svg>
    <span class="flex flex-col leading-none">
      <span class="text-[0.68rem] font-medium tracking-wide text-ink/70">Download on the</span>
      <span class="mt-1 text-[1.1rem] font-semibold tracking-tight">App Store</span>
    </span>
  </a>
  <a
    href={site.googlePlay}
    class="group inline-flex h-14 items-center gap-3 rounded-2xl border border-white/15 bg-white/[0.04] pr-5 pl-4 text-white transition duration-300 hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/[0.08]"
    aria-label="BeWise on Google Play (coming soon)"
  >
    <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true">
      <path fill="#00d9f2" d="M3.6 2.3c-.3.3-.5.8-.5 1.4v16.6c0 .6.2 1.1.5 1.4l9.3-9.7-9.3-9.7Z" />
      <path fill="#a6ffcb" d="m16 15.1-3.1-3.1-9.3 9.7c.4.4 1 .4 1.7 0L16 15.1Z" />
      <path fill="#1fa2ff" d="M5.3 2.3c-.7-.4-1.3-.4-1.7 0l9.3 9.7 3.1-3.1L5.3 2.3Z" />
      <path fill="#ff5f8f" d="m20.1 10.7-4.1-1.8-3.1 3.1 3.1 3.1 4.1-1.8c1.2-.7 1.2-1.9 0-2.6Z" />
    </svg>
    <span class="flex flex-col leading-none">
      <span class="text-[0.68rem] font-medium tracking-wide text-white/60">Coming soon to</span>
      <span class="mt-1 text-[1.1rem] font-semibold tracking-tight">Google Play</span>
    </span>
  </a>
</div>
